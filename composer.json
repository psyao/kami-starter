{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "psyao/kami-starter",
    "type": "project",
    "description": "A Laravel application wired for Psyao Kami, the Laravel and Filament CMS.",
    "keywords": ["laravel", "filament", "cms", "kami"],
    "homepage": "https://github.com/psyao/kami-starter",
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "filament/filament": "^5.10",
        "laravel/framework": "^13.32",
        "laravel/tinker": "^3.0",
        "psyao/kami": "dev-main"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.7",
        "evilmartians/lefthook": "^2.2",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.13",
        "laravel-lang/common": "^6.8",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.32",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "rector/rector": "^2.8"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan kami:install",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "analyse": "phpstan analyse",
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade",
            "@php -r \"is_dir('.git') && is_file('vendor/bin/lefthook') && passthru('vendor/bin/lefthook install');\""
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
